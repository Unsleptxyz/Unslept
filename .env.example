# Unslept configuration
# Every chain parameter and address is read from here. Nothing is hardcoded.
# Leave a value empty when it is not known yet. The app shows a clear
# "not configured" state instead of guessing.
# For the web app, copy the web-related keys into web/.env.local.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public base URL, used for metadata and canonical links. Example: https://www.unslept.xyz
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DOCS_URL=/docs
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_X_URL=https://x.com/Unsleptxyz
# Privy app ID (public). When set, the app connects wallets through Privy.
NEXT_PUBLIC_PRIVY_APP_ID=

# ---------------------------------------------------------------------------
# Robinhood Chain mainnet
# Values from Paxos's USDG integrator docs (docs.paxos.com/guides/stablecoin/usdg/mainnet), checked 2026-10-31.
# Re-check before deploying. Use a dedicated RPC provider in production; the public RPC is rate limited.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Dedicated RPC for the app and API routes (public RPC is the fallback). Never handed to wallets.
NEXT_PUBLIC_APP_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
# CAIP-2 identifier used in x402 payment requirements
X402_NETWORK=eip155:4663

# ---------------------------------------------------------------------------
# Assets
# USDG (Global Dollar, Paxos) is the native stablecoin on Robinhood Chain. 6 decimals.
# Supports EIP-3009 transferWithAuthorization; EIP-712 domain name "Global Dollar", version "1".
# ---------------------------------------------------------------------------
NEXT_PUBLIC_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
USDG_EIP712_NAME=Global Dollar
USDG_EIP712_VERSION=1
# Asset used by the reference adapter (ERC-4626 with USDG as its asset). Ticker is display-only.
# Proposed: Spark Savings USDG (spUSDG), ERC-4626, instant redemptions, Credora "A" rating.
#   0xde770c84FE66E063336b31737cFE9790f18c4087  (source: yield.xyz and tradingstrategy.ai listings; verify on the explorer)
# Alternative: Steakhouse USDG V2 (Morpho), 0xBeEff033F34C046626B8D0A041844C5d1A5409dd. Withdrawals depend on lending utilization.
# Not compatible with ERC4626Adapter: Midas mGLO (plain ERC-20, KYC required before deposit).
REFERENCE_ASSET_ADDRESS=0xde770c84FE66E063336b31737cFE9790f18c4087
REFERENCE_ASSET_TICKER=spUSDG
REFERENCE_ASSET_ORACLE=
# Oracle data older than this many seconds is rejected
ORACLE_MAX_STALENESS_SECONDS=

# ---------------------------------------------------------------------------
# Protocol contracts. Mainnet deployment of 2026-10-31 (block 102271358): see contracts/deployments/4663.json
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BUFFER_ADDRESS=0xcD853fb30eCe3134Cf21e2f47B9e23eaf965F40D
NEXT_PUBLIC_SETTLEMENT_ROUTER_ADDRESS=0x1FeAB3B8f88FB0667B686fDCB0206194e88c984b
NEXT_PUBLIC_ALLOCATOR_ADDRESS=0x5684a28Ef362f1282Eb7ef7e4C154F5e21FEfcfd
NEXT_PUBLIC_FEE_MODULE_ADDRESS=0xacbE1938C5CA8EaeB06C9E5c7c7E3b5d4d75fAEC
NEXT_PUBLIC_AGENT_ACCOUNT_FACTORY_ADDRESS=0xCa7D38A833BFaCBE22E787f967552A78b07C1c77
NEXT_PUBLIC_STAKER_BUFFER_ADDRESS=
NEXT_PUBLIC_TIMELOCK_ADDRESS=0x2A407119d55e5cca2D51Cacc78000D49FeEcE777
# Shown on the docs contracts page
NEXT_PUBLIC_ADAPTER_ADDRESS=0xAf7f74801C2b439831feef6D1b4d39B4Ce717B66
NEXT_PUBLIC_ASSET_VAULT_ADDRESS=0xde770c84FE66E063336b31737cFE9790f18c4087
# Block the contracts were deployed in (event scans start here)
NEXT_PUBLIC_DEPLOY_BLOCK=102271358
# ERC-4337 EntryPoint v0.7 on Robinhood Chain. Empty disables user operations.
ENTRY_POINT_ADDRESS=

# ---------------------------------------------------------------------------
# Protocol parameters
# ---------------------------------------------------------------------------
# Instant-settlement fee in basis points. Must sit inside the contract's hard bounds.
SETTLEMENT_FEE_BPS=
# Buffer target as a share of total value working, in basis points
BUFFER_TARGET_BPS=
# Utilization above which withdrawals enter the queue, in basis points
WITHDRAW_QUEUE_THRESHOLD_BPS=
# Timelock delay for parameter changes, in seconds
TIMELOCK_DELAY_SECONDS=
# Multisig that proposes and executes timelock operations and can pause the protocol
PAUSER_MULTISIG_ADDRESS=
# Buffer deposit cap and per-asset cap, atomic USDG (6 decimals)
# Guarded launch (no audit yet): both at most 50,000 USDG = 50000000000
BUFFER_DEPOSIT_CAP=50000000000
ASSET_CAP=50000000000

# ---------------------------------------------------------------------------
# Deployment (contracts/script/Deploy.s.sol)
# ---------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=
# Address allowed to park idle funds (Allocator KEEPER_ROLE)
KEEPER_ADDRESS=
# Mainnet guard. Without an audit report URL the script refuses a live chain unless
# UNAUDITED_LAUNCH_ACK is the exact sentence in Deploy.s.sol; caps are then limited to 50,000 USDG.
AUDIT_REPORT_URL=
NEXT_PUBLIC_AUDIT_REPORT_URL=
UNAUDITED_LAUNCH_ACK=
STAKING_COOLDOWN_SECONDS=
STAKER_TIER_MIN_STAKE=

# ---------------------------------------------------------------------------
# $UNSLEPT token (launches on Pons, Robinhood Chain)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_UNSLEPT_TOKEN_ADDRESS=
NEXT_PUBLIC_PONS_TOKEN_URL=

# ---------------------------------------------------------------------------
# x402
# ---------------------------------------------------------------------------
# Facilitator base URL (verify and settle endpoints). Configurable on purpose.
X402_FACILITATOR_URL=

# ---------------------------------------------------------------------------
# Indexer (indexer/, Ponder). INDEXER_URL empty means the stats section shows the pre-launch state.
# ---------------------------------------------------------------------------
INDEXER_URL=
INDEXER_RPC_URL=
# Adapters counted as "value working", comma-separated
INDEXER_ADAPTERS=
INDEXER_RATE_WINDOW_DAYS=7

# ---------------------------------------------------------------------------
# SDK and MCP server (agent side)
# ---------------------------------------------------------------------------
UNSLEPT_AGENT_ACCOUNT=
UNSLEPT_SIGNER_KEY=
UNSLEPT_NETWORK=robinhood-chain
UNSLEPT_CHAIN_ID=4663
UNSLEPT_RPC_URL=
UNSLEPT_USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
UNSLEPT_ROUTER=
# Buffer and optional staker buffer, comma-separated
UNSLEPT_BUFFERS=

# ---------------------------------------------------------------------------
# Keeper (ops/keeper.sh) and monitor (monitor/)
# ---------------------------------------------------------------------------
KEEPER_RPC_URL=
KEEPER_PRIVATE_KEY=
KEEPER_ADAPTER=
KEEPER_MIN_PARK_USDG=1000000
MONITOR_RPC_URL=
MONITOR_ADAPTERS=
MONITOR_LOOKBACK_BLOCKS=5000
TIMELOCK_ADDRESS=
OPS_WEBHOOK_URL=
OPS_UTILIZATION_ALERT_BPS=
OPS_MIN_AVAILABLE_USDG=

# ---------------------------------------------------------------------------
# Waitlist storage
# ---------------------------------------------------------------------------
# Supabase project used to store the waitlist (table: un_waitlist).
# Server-side only. Never expose the service role key to the browser.
SUPABASE_URL=
# Publishable key: enough for the waitlist (insert-only policy). Service role key: needed for webhooks and alerts.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Compliance (web/src/lib/compliance.ts). No KYC by default: leave COMPLIANCE_PROVIDER empty.
# Access is then decided by COMPLIANCE_BLOCKED_COUNTRIES only. A provider can be plugged in later if ever needed.
# ---------------------------------------------------------------------------
# "allowlist" or "http"
COMPLIANCE_PROVIDER=
COMPLIANCE_ALLOWLIST=
COMPLIANCE_API_URL=
COMPLIANCE_API_KEY=
# ISO 3166-1 alpha-2, comma-separated
COMPLIANCE_BLOCKED_COUNTRIES=
COMPLIANCE_ALLOWED_COUNTRIES=
