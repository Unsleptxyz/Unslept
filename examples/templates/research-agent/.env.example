# From https://www.unslept.xyz/app/developers
UNSLEPT_AGENT=<agent account address>
UNSLEPT_SIGNER_KEY=<agent signer secret key, base58>
UNSLEPT_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: only call this category, and stop after this many atomic USDC (50000 = 0.05 USDC)
CATEGORY=
BUDGET=50000
