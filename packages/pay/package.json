{
  "name": "@unslept/pay",
  "version": "0.2.0",
  "description": "Accept x402 payments in USDC on Solana from AI agents. Paywall middleware for Fetch-style handlers (Next.js, Hono, Bun) and Express. No dependencies.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unsleptxyz/Unslept.git",
    "directory": "packages/pay"
  },
  "homepage": "https://www.unslept.xyz/pay",
  "keywords": [
    "x402",
    "payments",
    "paywall",
    "usdc",
    "solana",
    "ai-agents"
  ]
}
