{
  "name": "@unslept/sdk",
  "version": "0.2.0",
  "description": "Pay x402 paywalls in USDC on Solana from an Unslept agent account whose balance earns yield on Kamino.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./solana": {
      "types": "./dist/solana.d.ts",
      "import": "./dist/solana.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.98.0"
  },
  "peerDependenciesMeta": {
    "@solana/web3.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@solana/web3.js": "^1.98.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unsleptxyz/Unslept.git",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://www.unslept.xyz/docs",
  "keywords": [
    "x402",
    "solana",
    "usdc",
    "ai-agents",
    "payments",
    "kamino"
  ]
}
